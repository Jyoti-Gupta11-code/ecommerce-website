# ==========================================
# Backend Production Environment Variables
# ==========================================

# Server Port (assigned automatically by cloud hosts like Render)
PORT=4000

# CORS Allowed Origins (Comma-separated URLs for production frontend & admin)
FRONTEND_URL=
ADMIN_URL=

# MongoDB Database Connection
MONGODB_URI=

# JWT Secret for User Authentication
JWT_SECRET=

# Admin Login Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (Image Hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe Payment Gateway
STRIPE_SECRET_KEY=

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Google Gemini API (AI Voice Assistant & Recommendations)
GEMINI_API_KEY=
